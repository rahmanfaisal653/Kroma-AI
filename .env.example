# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# KROOMBASE_API_KEY: Master key for Kroombase PostgREST API
KROOMBASE_API_KEY="YOUR_KROOMBASE_API_KEY"

# Server
PORT=20202

# Internal gateway mode
INTERNAL_GATEWAY_MODE=true
BILLING_ENABLED=false
RAG_ENABLED=false

# Internal /v1 gateway providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Optional global timeout fallback (used only when apis.timeout_ms is empty)
DEFAULT_TIMEOUT_MS="600000"
DEFAULT_STREAM_TIMEOUT_MS="180000"
GATEWAY_RETRY_MAX="1"
GATEWAY_RETRY_BACKOFF_MS="1200"
GATEWAY_MAX_MESSAGES="16"

# JWT_SECRET: Required for signing JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION"

SCRAPER_API_URL=http://localhost:14500/scrape

PORTAINER_URL=http://localhost:14502

CHROMADB_URL=http://localhost:14501
CHROMADB_COLLECTION_NAME=knowledge_base

OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b
RAG_CACHE_TTL_MS=600000
RAG_AUTO_REFRESH_MS=300000
RAG_AUTO_INGEST_ON_CHAT=true
RAG_FORCE_REFRESH_ON_RECENCY=true
RAG_MAX_DISTANCE_THRESHOLD=0.75

# Security hardening
# Restrict frontend origins (comma-separated). Empty means default CORS behavior.
# Example: CORS_ORIGIN=http://localhost:5173,https://your-admin-domain.com
CORS_ORIGIN=https://kroombridge.kroombox.com

# Block SSRF to private/local hosts by default for /api/rag/generate targetUrl scraping.
# Set true ONLY in trusted private network.
ALLOW_PRIVATE_SCRAPE_TARGETS=true

# Optional: auto-ingest fallback sources for recency queries without explicit URL.
# Example:
# DEFAULT_RAG_AUTO_URLS=https://id.wikipedia.org/wiki/Presiden_Indonesia,https://setkab.go.id
DEFAULT_RAG_AUTO_URLS=

# Frontend-side helper (optional), used when bundler exposes VITE_* envs.
VITE_DEFAULT_RAG_AUTO_URLS=
