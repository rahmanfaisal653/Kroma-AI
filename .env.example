# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# KROOMBASE_API_KEY: Master key for Kroombase PostgREST API
KROOMBASE_API_KEY="YOUR_KROOMBASE_API_KEY"

# Server
PORT=20202

# Internal gateway mode
INTERNAL_GATEWAY_MODE=true
BILLING_ENABLED=false

# Internal /v1 gateway providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Optional global timeout fallback (used only when apis.timeout_ms is empty)
DEFAULT_TIMEOUT_MS="600000"
DEFAULT_STREAM_TIMEOUT_MS="180000"
GATEWAY_RETRY_MAX="1"
GATEWAY_RETRY_BACKOFF_MS="1200"
GATEWAY_MAX_MESSAGES="16"

# JWT_SECRET: Required for signing JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION"


PORTAINER_URL=http://localhost:14502







# Security hardening
# Restrict frontend origins (comma-separated). Empty means default CORS behavior.
# Example: CORS_ORIGIN=http://localhost:5173,https://your-admin-domain.com
CORS_ORIGIN=https://kroombridge.kroombox.com

# Set true ONLY in trusted private network.

# Optional: auto-ingest fallback sources for recency queries without explicit URL.
# Example:
# DEFAULT_
DEFAULT_

# Frontend-side helper (optional), used when bundler exposes VITE_* envs.
VITE_DEFAULT_
